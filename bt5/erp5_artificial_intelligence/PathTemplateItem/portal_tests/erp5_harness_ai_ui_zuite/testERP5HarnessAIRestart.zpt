<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test ERP5 Harness AI - Restart</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test ERP5 Harness AI - Restart</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tal:block metal:use-macro="here/Zuite_CommonTemplateForErp5HarnessAI/macros/open_fixture_task" />
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
<td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please say hello');return cm.getValue();})()</td>
  <td>Please say hello</td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForErp5HarnessAI/macros/post_comment_and_wait_for_activities" />
<tr>
  <td>waitForTextPresent</td>
  <td>Hello from the fake LLM!</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please say hello again');return cm.getValue();})()</td>
  <td>Please say hello again</td>
</tr>

<tal:block metal:use-macro="here/Zuite_CommonTemplateForErp5HarnessAI/macros/post_comment_and_wait_for_activities" />
<tr>
  <td>waitForTextPresent</td>
  <td>Hello again from the fake LLM!</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>