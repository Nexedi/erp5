<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test ERP5 Harness AI - Restart</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test ERP5 Harness AI - Restart</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tal:block metal:use-macro="here/Zuite_CommonTemplateForErp5HarnessAI/macros/open_fixture_task" />
<tr>
  <td>getEval</td>
  <td>window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror.setValue('Please say hello')</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForErp5HarnessAI/macros/post_comment_and_wait_for_activities" />
<tr>
  <td>waitForTextPresent</td>
  <td>Hello from the fake LLM!</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>css=div.CodeMirror</td>
  <td></td>
</tr>
<tr>
  <td>getEval</td>
  <td>window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror.setValue('Please say hello again')</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForErp5HarnessAI/macros/post_comment_and_wait_for_activities" />
<tr>
  <td>waitForTextPresent</td>
  <td>Hello again from the fake LLM!</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>
