<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - LLM Error Handling</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - LLM Error Handling</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/setup_fake_llm_and_new_task" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please return an LLM error');return cm.getValue();})()</td>
  <td>Please return an LLM error</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>LLM 500 error: Simulated LLM failure</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[contains(@class, 'post-tool-entry')][contains(., 'Tool: rate_limit_retry') and contains(., 'retry 3 of 3')]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='error' and text()='Error']</td>
  <td></td>
</tr>
<tr>
  <td>verifyElementNotPresent</td>
  <td>//div[contains(@class, 'post-tool-entry')][contains(., 'retry 4 of 3')]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-error'][contains(., 'LLM 500 error: Simulated LLM failure')]</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please check the history for errors');return cm.getValue();})()</td>
  <td>Please check the history for errors</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'Error in history: False')]</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>