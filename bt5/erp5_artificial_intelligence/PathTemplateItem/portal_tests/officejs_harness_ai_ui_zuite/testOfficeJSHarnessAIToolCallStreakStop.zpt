<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - Tool Call Streak Stop</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - Tool Call Streak Stop</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/setup_fake_llm_and_new_task" />
<tr>
  <td>getEval</td>
  <td>window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror.setValue('Please run the stuck run_wasm streak test')</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='error' and text()='Error']</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>streak_test() -> 1</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>turns in a row, with different arguments each time.</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>This tool is disabled for the rest of this task: it was called 24 turns in a row</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>Stopped: the model called "run_wasm" 32 turns in a row without giving an answer.</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>
