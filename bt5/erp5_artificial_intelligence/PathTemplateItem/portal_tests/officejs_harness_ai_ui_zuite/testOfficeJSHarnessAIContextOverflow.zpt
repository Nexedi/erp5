<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - Context Overflow Error</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - Context Overflow Error</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/setup_fake_llm_and_new_task" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Filler one ' + 'x'.repeat(30000));return cm.getValue().length > 0;})()</td>
  <td>true</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Filler two ' + 'y'.repeat(30000));return cm.getValue().length > 0;})()</td>
  <td>true</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the context overflow test');return cm.getValue();})()</td>
  <td>Please run the context overflow test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[contains(@class, 'post-tool-entry')][contains(., 'Tool: context_overflow_retry') and contains(., 'context_length_exceeded')]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[contains(@class, 'post-tool-entry')][contains(., 'Tool: compact_history') and contains(., 'Conversation getting long - summarizing')]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'Context overflow recovered.')]</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>