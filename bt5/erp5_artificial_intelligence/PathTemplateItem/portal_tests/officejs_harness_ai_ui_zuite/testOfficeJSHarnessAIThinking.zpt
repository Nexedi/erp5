<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - Thinking</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - Thinking</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/load_setting_page" />
<tr>
  <td>type</td>
  <td>//input[@name='base_url']</td>
  <td>${base_url}/ERP5Site_fakeChatCompletions</td>
</tr>
<tr>
  <td>type</td>
  <td>//input[@name='api_key']</td>
  <td>test-api-key</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//select[@id='model']/option[@value='test-model']</td>
  <td></td>
</tr>
<tr>
  <td>select</td>
  <td>id=model</td>
  <td>value=test-model</td>
</tr>
<tr>
  <td>check</td>
  <td>//input[@name='thinking']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//button[@data-i18n='Proceed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//button[@data-i18n='Proceed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//h1[text()='Hello! How can I help you today?']</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/goto_new_artificial_task" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please check thinking parameter');return cm.getValue();})()</td>
  <td>Please check thinking parameter</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>Thinking parameter: enabled.</td>
  <td></td>
</tr>
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the reasoning tool test');return cm.getValue();})()</td>
  <td>Please run the reasoning tool test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>Hello from the fake HTTP endpoint!</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>The reasoning was sent back.</td>
  <td></td>
</tr>
<tr>
  <td>assertElementPresent</td>
  <td>//details[@class='post-assistant-reasoning']/summary[text()='Thinking']</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>
