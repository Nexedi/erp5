<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - pdf_to_text Tool</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - pdf_to_text Tool</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/setup_fake_llm_and_new_task" />
<!-- Without file_name, the last PDF attached is read, with pdf.js in the sandbox worker -->
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the pdf_to_text tool test');return cm.getValue();})()</td>
  <td>Please run the pdf_to_text tool test</td>
</tr>
<tr>
  <td>setFile</td>
  <td>attachment</td>
  <td>${base_url}/pdf_to_text_test_document.pdf pdf_to_text_test_document.pdf application/pdf</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//a[text()='pdf_to_text_test_document.pdf']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'PDF: pdf_to_text_test_document.pdf (1 page')]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'PDF-TO-TEXT-OK from the test document')]</td>
  <td></td>
</tr>
<!-- An unknown file_name is reported to the model -->
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the pdf_to_text missing file test');return cm.getValue();})()</td>
  <td>Please run the pdf_to_text missing file test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'ERROR: no PDF attachment named')]</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>