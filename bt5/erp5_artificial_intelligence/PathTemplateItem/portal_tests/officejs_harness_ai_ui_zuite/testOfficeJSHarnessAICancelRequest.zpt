<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - Cancel Request</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - Cancel Request</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/setup_fake_llm_and_new_task" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('please work then stall for the cancel test');return cm.getValue();})()</td>
  <td>please work then stall for the cancel test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>Hello from the fake HTTP endpoint!</td>
  <td></td>
</tr>
<tr>
  <td>waitForVisible</td>
  <td>id=cancel_button</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>id=cancel_button</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Cancelled']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'WORK-DONE-BEFORE-CANCEL.')]</td>
  <td></td>
</tr>
<tr>
  <td>assertElementPresent</td>
  <td>//div[contains(@class, 'post-tool-entry')][contains(., 'Tool: cancelled') and contains(., 'Cancelled by user')]</td>
  <td></td>
</tr>
<tr>
  <td>assertElementNotPresent</td>
  <td>//li[contains(@class, 'post-answer')]//div[@class='post-markdown'][contains(., 'Cancelled by user')]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>
