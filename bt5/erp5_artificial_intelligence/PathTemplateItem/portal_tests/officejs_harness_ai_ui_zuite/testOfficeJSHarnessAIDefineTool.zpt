</tr>
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the list_defined_tools tool test');return cm.getValue();})()</td>
  <td>Please run the list_defined_tools tool test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
