<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - Basic Navigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - Basic Navigation</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForRenderjsUi/macros/wait_for_app_loaded" />
<tr>
  <td>waitForTextPresent</td>
  <td>Artificial Tasks</td>
  <td></td>
</tr>

<tr>
  <td>waitForElementPresent</td>
  <td>//button[@data-i18n='Menu']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//button[@data-i18n='Menu']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//a[text()='Setting']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//a[text()='Setting']</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForRenderjsUi/macros/wait_for_content_loaded" />
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@name='base_url']</td>
  <td></td>
</tr>
<tr>
  <td>type</td>
  <td>//input[@name='base_url']</td>
  <td>${base_url}/ERP5Site_fakeChatCompletions</td>
</tr>
<tr>
  <td>type</td>
  <td>//input[@name='api_key']</td>
  <td>test-api-key</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//select[@id='model']/option</td>
  <td></td>
</tr>
<tr>
  <td>select</td>
  <td>id=model</td>
  <td>index=0</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//button[@data-i18n='Proceed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//button[@data-i18n='Proceed']</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForRenderjsUi/macros/wait_for_content_loaded" />

<tr>
  <td>waitForElementPresent</td>
  <td>//button[@data-i18n='Menu']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//button[@data-i18n='Menu']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//a[text()='New Artificial Task']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//a[text()='New Artificial Task']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
