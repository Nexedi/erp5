<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Test OfficeJS Harness AI - Repeated Tool Call</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Test OfficeJS Harness AI - Repeated Tool Call</td></tr>
</thead><tbody>
<tal:block metal:use-macro="here/Zuite_CommonTemplate/macros/init" />
<tr>
  <td>open</td>
  <td>${base_url}/web_site_module/officejs_harness_ai/</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/setup_fake_llm_and_new_task" />
<!-- allow_repeat tool: never intercepted, so the guard notice must not
     appear yet. -->
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the repeated define_tool list test');return cm.getValue();})()</td>
  <td>Please run the repeated define_tool list test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>Tool result:</td>
  <td></td>
</tr>
<tr>
  <td>verifyTextNotPresent</td>
  <td>You already called this exact tool with these exact same arguments</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />
<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the repeated http_request tool test');return cm.getValue();})()</td>
  <td>Please run the repeated http_request tool test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementNotPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='success' and text()='Completed']</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>Hello from the fake HTTP endpoint!</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>You already called this exact tool with these exact same arguments</td>
  <td></td>
</tr>
<tal:block metal:use-macro="here/Zuite_CommonTemplateForHarnessAI/macros/wait_for_editor" />

<tr>
  <td>waitForEval</td>
  <td>(function(){var cm=window.document.querySelector('.chat-editor iframe').contentWindow.document.querySelector('.CodeMirror').CodeMirror;cm.setValue('Please run the stuck http_request tool test');return cm.getValue();})()</td>
  <td>Please run the stuck http_request tool test</td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>click</td>
  <td>//input[@data-i18n='[value]Post Comment'][not(@disabled)]</td>
  <td></td>
</tr>
<tr>
  <td>waitForElementPresent</td>
  <td>//div[@data-gadget-scope='notification' and @class='visible']//button[@class='error' and text()='Error']</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>This tool is now disabled for the rest of this task.</td>
  <td></td>
</tr>
<tr>
  <td>waitForTextPresent</td>
  <td>with the same arguments 5 times in the last 12 turns after being told to stop.</td>
  <td></td>
</tr>
</tbody></table>
</body>
</html>